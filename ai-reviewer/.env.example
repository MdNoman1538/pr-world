# Copy to .env and put your Gemini API key here. Never commit or share .env.
GEMINI_API_KEY=
# Optional: override models (see: python review.py models)
# GEMINI_FAST_MODEL=gemini-3.8-flash
# GEMINI_STRONG_MODEL=gemini-4-hydrogen
# Optional: how PR World shows trust: level (Low / Medium / High, default) or percent
# PRW_TRUST_VIEW=level
# Optional (v5): other model providers for roles in backend/prworld.yaml. Leave empty if unused.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Optional (v5): keys that seal company plugins and merge rules. Pick long random values; never share them.
# PRW_PLUGIN_SIGNING_KEY=
# PRW_POLICY_SIGNING_KEY=
